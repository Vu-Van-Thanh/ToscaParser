{
  "version": "2.0.0",
  "tasks": [
    {
      // The demo resolves etsi-vnfd-parser from the local repository, so a change under src/ only
      // reaches it after an install. Tests are skipped here on purpose - this runs on every F5, and
      // the suite has its own task below.
      "label": "install parser library",
      "type": "shell",
      "command": "mvn",
      "args": ["-q", "-DskipTests", "install"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$maven"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "library: test",
      "type": "shell",
      "command": "mvn",
      "args": ["-o", "clean", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$maven"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "demo: package",
      "type": "shell",
      "command": "mvn",
      "args": ["-q", "clean", "package", "-DskipTests"],
      "options": { "cwd": "${workspaceFolder}/demo" },
      "problemMatcher": ["$maven"],
      "group": "build"
    },
    {
      // Attaches sources of the library to the jar the demo resolves, so stepping into it shows
      // code even when the two projects are not open as one workspace.
      "label": "install parser library with sources",
      "type": "shell",
      "command": "mvn",
      "args": ["-q", "-DskipTests", "source:jar", "install"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$maven"],
      "group": "build"
    }
  ]
}
