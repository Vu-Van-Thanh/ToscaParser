<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!--
      2.7.x is the last line that supports Java 11, which is what the library targets. Staying on it
      means this demo proves the library works on the JDK it claims to, and keeps the javax.* servlet
      namespace a Spring Boot 2 host application would already be on.
    -->
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.example.etsi</groupId>
  <artifactId>etsi-vnfd-parser-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ETSI VNFD Parser Demo</name>
  <description>
    A Spring Boot consumer of etsi-vnfd-parser: calls the library and serves the parsed VNFD as JSON.
    Deliberately a separate Maven project - it depends on the published artifact, exactly as a host
    application would, so nothing here can reach into the library's internals.
  </description>

  <properties>
    <java.version>11</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <parser.version>0.1.0-SNAPSHOT</parser.version>
    <!--
      The library is built against Jackson 2.17.2. Overriding the version Spring Boot manages keeps
      one Jackson on the classpath instead of two.
    -->
    <jackson-bom.version>2.17.2</jackson-bom.version>
    <!--
      Spring Boot 2.7 manages SnakeYAML 1.30, which has no LoaderOptions.setNestingDepthLimit(int) -
      that arrived in 2.x. The parser calls it to bound document nesting, so leaving Boot's version
      in place gets a NoSuchMethodError on the first package read. A host application on Spring Boot
      2.7 needs this same override.
    -->
    <snakeyaml.version>2.2</snakeyaml.version>
  </properties>

  <dependencies>
    <!-- The library under test, resolved from the local repository (mvn install in the parent dir). -->
    <dependency>
      <groupId>com.example.etsi</groupId>
      <artifactId>etsi-vnfd-parser</artifactId>
      <version>${parser.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
